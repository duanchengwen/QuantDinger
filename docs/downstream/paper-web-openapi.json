            }
          }
        ]
      }
    },
    "/strategy-versions": {
      "get": {
        "summary": "List immutable strategy versions and human decisions for the caller’s paper account",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Strategy version and its human decisions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        1
                      ]
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "versions": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/PaperStrategyVersion"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, unsupported configuration, or invalid transition"
          },
          "401": {
            "description": "Human authentication required"
          },
          "503": {
            "description": "Database unavailable"
          }
        }
      },
      "post": {
        "summary": "Save an immutable deterministic paper strategy draft",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "request_key",
                  "config"
                ],
                "additionalProperties": false,
                "properties": {
                  "request_key": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{8,100}$"
                  },
                  "config": {
                    "$ref": "#/components/schemas/PaperStrategyConfig"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Strategy version and its human decisions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        1
                      ]
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/PaperStrategyVersion"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, unsupported configuration, or invalid transition"
          },
          "401": {
            "description": "Human authentication required"
          },
          "503": {
            "description": "Database unavailable"
          },
          "403": {
            "description": "Paper write permission required"
          }
        }
      }
    },
    "/strategy-versions/{version_id}/decision": {
      "post": {
        "summary": "Explicitly approve, enable for PAPER execution, or revoke an exact strategy version",
        "parameters": [
          {
            "name": "version_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "config_sha256",
                  "decision",
                  "confirmed"
                ],
                "additionalProperties": false,
                "properties": {
                  "config_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "decision": {
                    "type": "string",
                    "enum": [
                      "approved",
                      "activated",
                      "revoked"
                    ]
                  },
                  "confirmed": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Strategy version and its human decisions",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        1
                      ]
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/PaperStrategyVersion"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request, unsupported configuration, or invalid transition"
          },
          "401": {
            "description": "Human authentication required"
          },
          "503": {
            "description": "Database unavailable"
          },
          "403": {
            "description": "Paper write permission required"
          }
        }
      }
    }
  }
}
