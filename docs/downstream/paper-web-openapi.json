{
  "openapi": "3.0.3",
  "info": {
    "title": "A-share human paper API",
    "version": "0.8.0",
    "description": "Human JWT only; tenant derives from verified user. Real brokerage and Agent writes remain disabled."
  },
  "servers": [
    {
      "url": "/api/ashare-paper"
    }
  ],
  "security": [
    {
      "HumanJWT": []
    }
  ],
  "components": {
    "securitySchemes": {
      "HumanJWT": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ThemeSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "board_code",
          "board_name",
          "received_at",
          "source",
          "source_hash",
          "member_count",
          "provider_total",
          "excluded_count",
          "membership_semantics",
          "historical_membership_certified"
        ],
        "properties": {
          "board_code": {
            "type": "string",
            "pattern": "^BK[0-9]{4,8}$"
          },
          "board_name": {
            "type": "string"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "eastmoney"
            ]
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "member_count": {
            "type": "integer",
            "minimum": 0
          },
          "provider_total": {
            "type": "integer",
            "minimum": 1
          },
          "excluded_count": {
            "type": "integer",
            "minimum": 0
          },
          "membership_semantics": {
            "type": "string",
            "enum": [
              "current_observation"
            ]
          },
          "historical_membership_certified": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        }
      },
      "ThemeMember": {
        "type": "object",
        "required": [
          "symbol",
          "name",
          "provider_code",
          "provider_market"
        ],
        "properties": {
          "symbol": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "provider_code": {
            "type": "string"
          },
          "provider_market": {
            "type": "integer",
            "enum": [
              0,
              1
            ]
          }
        }
      },
      "ThemeSnapshot": {
        "type": "object",
        "description": "Verified current observation or explicit not_observed. No local filesystem path is returned.",
        "required": [
          "board_code",
          "status",
          "members",
          "member_count",
          "membership_semantics",
          "published_at"
        ],
        "properties": {
          "board_code": {
            "type": "string",
            "pattern": "^BK[0-9]{4,8}$"
          },
          "board_name": {
            "type": "string"
          },
          "received_at": {
            "type": "string",
            "format": "date-time"
          },
          "source": {
            "type": "string",
            "enum": [
              "eastmoney"
            ]
          },
          "source_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "member_count": {
            "type": "integer",
            "minimum": 0
          },
          "provider_total": {
            "type": "integer",
            "minimum": 1
          },
          "excluded_count": {
            "type": "integer",
            "minimum": 0
          },
          "membership_semantics": {
            "type": "string",
            "enum": [
              "current_observation"
            ]
          },
          "historical_membership_certified": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "observed",
              "not_observed"
            ]
          },
          "members": {
            "type": "array",
            "maxItems": 500,
            "items": {
              "$ref": "#/components/schemas/ThemeMember"
            }
          },
          "receipt_id": {
            "type": "string"
          },
          "published_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Unknown; never synthesized from retrieval time."
          },
          "known_at": {
            "type": "string",
            "format": "date-time"
          },
          "offset": {
            "type": "integer"
          },
          "limit": {
            "type": "integer"
          },
          "excluded_members": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "consistency": {
            "type": "string",
            "enum": [
              "paginated_not_atomic"
            ]
          },
          "auto_approval_eligible": {
            "type": "boolean",
            "enum": [
              false
            ]
          }
        }
      },
      "PaperStrategyConfig": {
        "type": "object",
        "required": [
          "mode",
          "kind",
          "symbol",
          "quantity",
          "threshold",
          "limit_price",
          "max_cash"
        ],
        "additionalProperties": false,
        "properties": {
          "mode": {
            "type": "string",
            "enum": [
              "paper"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "buy_once_below"
            ]
          },
          "symbol": {
            "type": "string",
            "pattern": "^(sh\\.60[0-9]{4}|sz\\.(000|001|002|003|300|301)[0-9]{3})$"
          },
          "quantity": {
            "type": "integer",
            "minimum": 100,
            "maximum": 1000000,
            "multipleOf": 100
          },
          "threshold": {
            "type": "string",
            "pattern": "^[0-9]{1,9}(\\.[0-9]{1,2})?$"
          },
          "limit_price": {
            "type": "string",
            "pattern": "^[0-9]{1,9}(\\.[0-9]{1,2})?$"
          },
          "max_cash": {
            "type": "string",
            "pattern": "^[0-9]{1,9}(\\.[0-9]{1,2})?$"
          }
        }
      },
      "PaperStrategyVersion": {
        "type": "object",
        "required": [
          "id",
          "config",
          "config_sha256",
          "created_at",
          "created_by",
          "status",
          "execution_allowed",
          "approved_at",
          "approved_by",
          "revoked_at",
          "revoked_by",
          "activated_at",
          "activated_by"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "config": {
            "$ref": "#/components/schemas/PaperStrategyConfig"
          },
          "config_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "created_by": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "approved",
              "revoked"
            ]
          },
          "execution_allowed": {
            "type": "boolean",
            "description": "An explicit activation exists and the version has not been revoked. The worker also requires fresh quotes, today’s human rules and available risk budget."
          },
          "approved_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "approved_by": {
            "type": "integer",
            "nullable": true
          },
          "revoked_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "revoked_by": {
            "type": "integer",
            "nullable": true
          },
          "activated_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "activated_by": {
            "type": "integer",
            "nullable": true
          }
        }
      }
    }
  },
  "paths": {
    "/state": {
      "get": {
        "summary": "/state",
        "responses": {
          "200": {
            "description": "Human envelope code=1, data; notifications never expose credentials"
          },
          "400": {
            "description": "Rejected request"
          },
          "401": {
            "description": "Invalid human session"
          },
          "403": {
            "description": "Viewer write denied"
          },
          "503": {
            "description": "Paper database unavailable"
          }
        }
      }
    },
    "/initialize": {
      "post": {
        "summary": "/initialize",
        "responses": {
          "200": {
            "description": "Human envelope code=1, data; notifications never expose credentials"
          },
          "400": {
            "description": "Rejected request"
          },
          "401": {
            "description": "Invalid human session"
          },
          "403": {
            "description": "Viewer write denied"
          },
          "503": {
            "description": "Paper database unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "initial_cash": {
                    "type": "string"
                  }
                },
                "required": [
                  "initial_cash"
                ]
              }
            }
          }
        }
      }
    },
    "/settings": {
      "put": {
        "summary": "/settings",
        "responses": {
          "200": {
            "description": "Human envelope code=1, data; notifications never expose credentials"
          },
          "400": {
            "description": "Rejected request"
          },
          "401": {
            "description": "Invalid human session"
          },
          "403": {
            "description": "Viewer write denied"
          },
          "503": {
            "description": "Paper database unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "symbols": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "minItems": 1,
                    "maxItems": 30
                  },
                  "interval_seconds": {
                    "type": "integer",
                    "minimum": 2,
                    "maximum": 3600
                  },
                  "research_preferences": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "topics": {
                        "type": "array",
                        "maxItems": 4,
                        "uniqueItems": true,
                        "items": {
                          "enum": [
                            "ai",
                            "robotics",
                            "new_energy",
                            "semiconductors"
                          ]
                        }
                      },
                      "follow_current_events": {
                        "type": "boolean"
                      },
                      "custom_topics": {
                        "type": "string",
                        "maxLength": 240
                      }
                    }
                  }
                },
                "required": [
                  "symbols",
                  "interval_seconds"
                ]
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "summary": "/orders Strategy idempotency keys are reserved for the worker.",
        "responses": {
          "200": {
            "description": "Human envelope code=1, data; notifications never expose credentials"
          },
          "400": {
            "description": "Rejected request"
          },
          "401": {
            "description": "Invalid human session"
          },
          "403": {
            "description": "Viewer write denied"
          },
          "503": {
            "description": "Paper database unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "client_order_id": {
                    "type": "string"
                  },
                  "symbol": {
                    "type": "string"
                  },
                  "side": {
                    "enum": [
                      "buy",
                      "sell"
                    ]
                  },
                  "quantity": {
                    "type": "integer",
                    "multipleOf": 100,
                    "minimum": 100
                  },
                  "limit_price": {
                    "type": "string"
                  }
                },
                "required": [
                  "client_order_id",
                  "symbol",
                  "side",
                  "quantity",
                  "limit_price"
                ]
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}/cancel": {
      "post": {
        "summary": "/orders/{order_id}/cancel",
        "responses": {
          "200": {
            "description": "Human envelope code=1, data; notifications never expose credentials"
          },
          "400": {
            "description": "Rejected request"
          },
          "401": {
            "description": "Invalid human session"
          },
          "403": {
            "description": "Viewer write denied"
          },
          "503": {
            "description": "Paper database unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              }
            }
          }
        },
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer"
            }
          }
        ]
      }
    },
    "/rules/review": {
      "post": {
        "summary": "/rules/review",
        "responses": {
          "200": {
            "description": "Human envelope code=1, data; notifications never expose credentials"
          },
          "400": {
            "description": "Rejected request"
          },
          "401": {
            "description": "Invalid human session"
          },
          "403": {
            "description": "Viewer write denied"
          },
          "503": {
            "description": "Paper database unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "symbol": {
                    "type": "string"
                  },
                  "trading_day": {
                    "type": "string",
                    "format": "date"
                  },
                  "suspended": {
                    "type": "boolean"
                  },
                  "st": {
                    "type": "boolean"
                  },
                  "evidence": {
                    "type": "string"
                  },
                  "limit_up": {
                    "type": "string"
                  },
                  "limit_down": {
                    "type": "string"
                  }
                },
                "required": [
                  "symbol",
                  "trading_day",
                  "suspended",
                  "st",
                  "evidence",
                  "limit_up",
                  "limit_down"
                ]
              }
            }
          }
        }
      }
    },
    "/notifications/config": {
      "post": {
        "summary": "/notifications/config",
        "responses": {
          "200": {
            "description": "Human envelope code=1, data; notifications never expose credentials"
          },
          "400": {
            "description": "Rejected request"
          },
          "401": {
            "description": "Invalid human session"
          },
          "403": {
            "description": "Viewer write denied"
          },
          "503": {
            "description": "Paper database unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "webhook_url": {
                    "type": "string",
                    "writeOnly": true
                  },
                  "signing_secret": {
                    "type": "string",
                    "writeOnly": true
                  }
                },
                "required": [
                  "webhook_url"
                ]
              }
            }
          }
        }
      }
    },
    "/notifications/test": {
      "post": {
        "summary": "/notifications/test",
        "responses": {
          "200": {
            "description": "Human envelope code=1, data; notifications never expose credentials"
          },
          "400": {
            "description": "Rejected request"
          },
          "401": {
            "description": "Invalid human session"
          },
          "403": {
            "description": "Viewer write denied"
          },
          "503": {
            "description": "Paper database unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "properties": {},
                "required": []
              }
            }
          }
        }
      }
    },
    "/daily-reports": {
      "get": {
        "summary": "Read immutable daily paper ledger reports for the authenticated account",
        "responses": {
          "200": {
            "description": "Human envelope code=1. Each item includes trading_day, generated_at, report, and feishu_delivery. Delivery status is not_observed, unknown, webhook_acknowledged, disabled, rejected or failed. Webhook acknowledgement records provider acceptance. Missing equity is null."
          },
          "400": {
            "description": "Rejected request"
          },
          "401": {
            "description": "Invalid human session"
          },
          "403": {
            "description": "Viewer write denied"
          },
          "503": {
            "description": "Paper database unavailable"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "name": "_t",
            "in": "query",
            "required": false,
            "description": "Ignored cache-busting value appended by the official frontend.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/rules/suggestions": {
      "get": {
        "summary": "Read current-day quote and dated security-status suggestions. Unknown fields remain null. Never grants approval.",
        "responses": {
          "200": {
            "description": "Human envelope code=1, data; notifications never expose credentials"
          },
          "400": {
            "description": "Rejected request"
          },
          "401": {
            "description": "Invalid human session"
          },
          "403": {
            "description": "Viewer write denied"
          },
          "503": {
            "description": "Paper database unavailable"
          }
        },
        "parameters": [
          {
            "name": "_t",
            "in": "query",
            "required": false,
            "description": "Ignored cache-busting value appended by the official frontend.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/rules/review-batch": {
      "post": {
        "summary": "Atomically persist 1..30 explicitly human-confirmed daily reviews. Any rejected row rejects the entire batch.",
        "responses": {
          "200": {
            "description": "Human envelope code=1, data; notifications never expose credentials"
          },
          "400": {
            "description": "Rejected request"
          },
          "401": {
            "description": "Invalid human session"
          },
          "403": {
            "description": "Viewer write denied"
          },
          "503": {
            "description": "Paper database unavailable"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "confirmed",
                  "rules"
                ],
                "properties": {
                  "confirmed": {
                    "type": "boolean",
                    "enum": [
                      true
                    ]
                  },
                  "rules": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 30,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "symbol": {
                          "type": "string"
                        },
                        "trading_day": {
                          "type": "string",
                          "format": "date"
                        },
                        "suspended": {
                          "type": "boolean"
                        },
                        "st": {
                          "type": "boolean"
                        },
                        "evidence": {
                          "type": "string"
                        },
                        "limit_up": {
                          "type": "string"
                        },
                        "limit_down": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "symbol",
                        "trading_day",
                        "suspended",
                        "st",
                        "evidence",
                        "limit_up",
                        "limit_down"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/universe": {
      "get": {
        "summary": "Read an evidence-backed dated universe, not current constituents projected into history. Missing date is unavailable.",
        "responses": {
          "200": {
            "description": "Human envelope code=1, data; notifications never expose credentials"
          },
          "400": {
            "description": "Rejected request"
          },
          "401": {
            "description": "Invalid human session"
          },
          "403": {
            "description": "Viewer write denied"
          },
          "503": {
            "description": "Paper database unavailable"
          }
        },
        "parameters": [
          {
            "name": "trading_day",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "format": "date"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20000,
              "default": 0
            }
          },
          {
            "name": "_t",
            "in": "query",
            "required": false,
            "description": "Ignored cache-busting value appended by the official frontend.",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/themes": {
      "get": {
        "summary": "List at most twenty latest distinct verified theme observations",
        "description": "Human JWT including viewer; Agent tokens rejected. Reads existing observations only: no collection, account initialization, approval, or order writes. Unknown and duplicate query parameters are rejected. Missing/corrupt source evidence fails the whole response; no partial verified list. Only current known versions are exposed.",
        "parameters": [
          {
            "name": "_t",
            "in": "query",
            "required": false,
            "description": "Ignored official frontend cache-busting value; at most one occurrence.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Human success envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "msg",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        1
                      ]
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "type": "object",
                      "required": [
                        "themes",
                        "status"
                      ],
                      "properties": {
                        "themes": {
                          "type": "array",
                          "maxItems": 20,
                          "items": {
                            "$ref": "#/components/schemas/ThemeSummary"
                          }
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "observed",
                            "not_observed"
                          ]
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid board/query or pagination; known_at/date and duplicate parameters are forbidden."
          },
          "401": {
            "description": "Missing or invalid human JWT, including Agent tokens."
          },
          "503": {
            "description": "Database or evidence unavailable; no internal paths or exception details."
          }
        }
      }
    },
    "/themes/{board_code}": {
      "get": {
        "summary": "Read a verified current theme member page",
        "description": "Human JWT including viewer; Agent tokens rejected. Reads existing observations only: no collection, account initialization, approval, or order writes. Unknown and duplicate query parameters are rejected. Missing/corrupt source evidence fails the whole response; no partial verified list. Only current known versions are exposed.",
        "parameters": [
          {
            "name": "board_code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^BK[0-9]{4,8}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 100
            }
          },
          {
            "name": "offset",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000,
              "default": 0
            }
          },
          {
            "name": "_t",
            "in": "query",
            "required": false,
            "description": "Ignored official frontend cache-busting value; at most one occurrence.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Human success envelope",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "code",
                    "msg",
                    "data"
                  ],
                  "properties": {
                    "code": {
                      "type": "integer",
                      "enum": [
                        1
                      ]
                    },
                    "msg": {
                      "type": "string"
                    },
                    "data": {
                      "$ref": "#/components/schemas/ThemeSnapshot"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid board/query or pagination; known_at/date and duplicate parameters are forbidden."
          },
          "401": {
            "description": "Missing or invalid human JWT, including Agent tokens."
          },
          "503": {
            "description": "Database or evidence unavailable; no internal paths or exception details."
          }
        }
      }
    },
    "/news": {
      "get": {
        "summary": "Verified limited recent issuer announcement titles for selected supported topics; no full-text or trading signal claim.",
        "responses": {
          "200": {
            "description": "Authenticated research response; execution_allowed is always false."
          },
          "400": {
            "description": "Invalid bounded query or unavailable run"
          },
          "401": {
            "description": "Human authentication required"
          },
          "503": {
            "description": "Evidence or database unavailable"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ]
      }
    },
    "/research/status": {
      "get": {
        "summary": "Configured DeepSeek status and latest tenant-scoped research; no secrets.",
        "responses": {
          "200": {
            "description": "Authenticated research response; execution_allowed is always false."
          },
          "400": {
            "description": "Invalid bounded query or unavailable run"
          },
          "401": {
            "description": "Human authentication required"
          },
          "503": {
            "description": "Evidence or database unavailable"
          }
        }
      }
    },
    "/research/runs": {
      "get": {
        "summary": "List tenant-scoped research runs; no raw model output.",
        "responses": {
          "200": {
            "description": "Authenticated research response; execution_allowed is always false."
          },
          "400": {
            "description": "Invalid bounded query or unavailable run"
          },
          "401": {
            "description": "Human authentication required"
          },
          "503": {
            "description": "Evidence or database unavailable"
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "default": 10
            }
          }
        ]
      },
      "post": {
        "summary": "Queue one bounded DeepSeek research request; no strategy approval or orders. At most 3 new requests per account/CST day; replay same key returns original run.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "idempotency_key"
                ],
                "properties": {
                  "idempotency_key": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{8,100}$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Durable queued or prior run"
          },
          "400": {
            "description": "Invalid input, missing paper account, active run or daily limit"
          },
          "401": {
            "description": "Human authentication required"
          },
          "403": {
            "description": "Viewer cannot write"
          },
          "503": {
            "description": "Evidence or database unavailable"
          }
        }
      }
    },
    "/research/runs/{run_id}": {
      "get": {
        "summary": "Read one tenant-scoped research run with verified input/output hashes.",
        "responses": {
          "200": {
            "description": "Authenticated research response; execution_allowed is always false."
          },
          "400": {
            "description": "Invalid bounded query or unavailable run"
          },
          "401": {
            "description": "Human authentication required"
          },
          "503": {
            "description": "Evidence or database unavailable"
          }
        },
        "parameters": [
