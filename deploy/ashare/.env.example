# Use scripts/ops/paper_stack.py init to create private persistent secrets.
ASHARE_HTTP_PORT=8077
ASHARE_FRONTEND_DIST=/absolute/path/to/prepared/quantdinger-frontend/dist
ASHARE_APP_IMAGE=quantdinger-ashare:local
ASHARE_POSTGRES_IMAGE=postgres:18@sha256:2ea8630df176ad090ec92136dee850397c5af8781e4bcf2e4162593691c61bbc
ASHARE_NGINX_IMAGE=nginx:1.30.6-alpine3.24-slim
ADMIN_USER=paper_admin
ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
ADMIN_EMAIL=admin@example.com
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
SECRET_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES

ASHARE_MIN_FREE_DISK_BYTES=104857600
